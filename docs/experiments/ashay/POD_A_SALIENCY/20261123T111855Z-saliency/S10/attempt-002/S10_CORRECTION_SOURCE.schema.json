{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pod-a:s10-correction:2",
  "type": "object",
  "required": [
    "schema_version",
    "counts",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "s10-correction-source-inventory-v2"
    },
    "counts": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "bytes",
          "sha256",
          "source_locator",
          "provider_revision",
          "revision_null_reason",
          "provider_declared_checksums",
          "provider_checksum_null_reason",
          "record_count",
          "scalar_count",
          "exact_checkpoint_binding"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provider_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider_declared_checksums": {
            "type": "array"
          },
          "exact_checkpoint_binding": {
            "type": "null"
          }
        }
      }
    }
  }
}
